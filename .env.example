# ── Base de datos (Supabase → Connect) ──
# Pooler en modo transacción (puerto 6543): lo usa la app, también en Vercel.
DATABASE_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Conexión directa o session pooler (puerto 5432): solo para "npm run db:push" y el seed.
DIRECT_URL=postgresql://postgres.PROYECTO:CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Admin inicial (se crea con "npm run db:seed") ──
ADMIN_EMAIL=dumatiasro@email.com
ADMIN_PASSWORD=abc123

# ── Sesión del panel admin (cambiala en producción) ──
SESSION_SECRET=generar-con-openssl-rand-hex-32

# ── URL pública del sitio (webhooks y redirecciones de pago) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pagos (Mercado Pago) — dejalo vacío mientras la tienda esté cerrada ──
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
