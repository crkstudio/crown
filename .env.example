# ── Admin inicial (se crea con "npm run db:seed") ──
ADMIN_EMAIL=tu@email.com
ADMIN_PASSWORD=cambiame-por-algo-seguro

# ── Sesión del panel admin (cambiala en producción) ──
SESSION_SECRET=generar-con-openssl-rand-hex-32

# ── URL pública del sitio (webhooks y redirecciones de pago) ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Pagos (Mercado Pago) — dejalo vacío mientras la tienda esté cerrada ──
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
